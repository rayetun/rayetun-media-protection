{
	"name": "rayetun/markguard",
	"description": "Watermark images and PDFs, protect downloadable files, and control who can access them.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Md Rayhan Uddin",
			"homepage": "https://rayetun.com"
		}
	],
	"require": {
		"php": ">=8.0",
		"tecnickcom/tcpdf": "^6.7",
		"setasign/fpdi": "^2.6"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^1.11",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Rayetun\\MarkGuard\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Rayetun\\MarkGuard\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyze": "phpstan analyze --memory-limit=1G",
		"test": "phpunit",
		"trim-fonts": "php scripts/trim-tcpdf-fonts.php",
		"post-install-cmd": [ "@trim-fonts" ],
		"post-update-cmd": [ "@trim-fonts" ]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true,
		"platform": {
			"php": "8.0"
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
