<?xml version="1.0"?>
<ruleset name="MarkGuard">
	<description>Coding standard for MarkGuard — WordPress-Extra with PHP 8.0+ compatibility.</description>

	<file>./rayetun-media-protection.php</file>
	<file>./uninstall.php</file>
	<file>./src</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="basepath" value="./"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.7"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="Generic.Files.LineLength"/>
	</rule>

	<rule ref="WordPress-Docs"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="rayetun-media-protection"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="markguard,MARKGUARD,Rayetun\MarkGuard"/>
		</properties>
	</rule>
</ruleset>
